    {"id": "UAT-SCOPE-001", "assertion": "A user cannot access a record outside organization/campus scope through UI or direct API."},
    {"id": "UAT-VERSION-001", "assertion": "Effective SOP, finalized Assessment and active Contract cannot be edited directly."},
    {"id": "UAT-FILE-001", "assertion": "A quarantined or unscanned document cannot be opened or linked as verified evidence."}
