{
  "name": "sop-os-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sop-os/web --filter @sop-os/api --filter @sop-os/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "data:guard": "node scripts/data-policy-guard.mjs",
    "db:reset:dev": "node scripts/reset-dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pilot:gate": "node scripts/pilot-gate.mjs",
    "local:start": "bash scripts/local-services.sh start",
    "local:rebuild": "bash scripts/local-services.sh rebuild",
    "local:restart": "bash scripts/local-services.sh restart",
    "local:status": "bash scripts/local-services.sh status",
    "local:logs": "bash scripts/local-services.sh logs",
    "local:stop": "bash scripts/local-services.sh stop",
    "github:protection:verify": "bash scripts/github-protection.sh verify",
    "github:protection:bootstrap": "bash scripts/github-protection.sh apply-bootstrap",
    "github:protection:review-gate": "bash scripts/github-protection.sh apply-review-gate",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
